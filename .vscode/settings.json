{
    "dart.flutterSdkPath": "/home/$(whoami)/development/flutter",
    "dart.previewFlutterUiGuides": false,
    "dart.previewFlutterUiGuidesCustomTracking": false,
    "dart.openDevTools": "none",
    "dart.debugExternalPackageLibraries": false,
    "dart.debugSdkLibraries": false,
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "none",
    "editor.wordWrap": "on",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/.flutter-plugins": true,
        "**/.packages": true,
        "**/*.g.dart": true,
        "**/*.freezed.dart": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/build": true,
        "**/.dart_tool": true,
        "**/*.g.dart": true,
        "**/*.freezed.dart": true
    },
    "dart.buildRunnerAdditionalArgs": [
        "--delete-conflicting-outputs"
    ],
    "flutter.runInTerminal": true,
    "dart.hotReloadOnSave": "manual"
}
